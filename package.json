{
  "name": "acornmc-org",
  "description": "The official website for AcornMC, a Minecraft server.",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/ssg/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@anuragroy/tailwindcss-animate": "^1.0.6",
    "@eslint/js": "latest",
    "@luminescent/icons-qwik": "^0.1.1",
    "@luminescent/ui": "^7.0.0",
    "@luminescent/ui-qwik": "7.0.0-2",
    "@qwik.dev/core": "2.0.0-beta.32",
    "@qwik.dev/router": "2.0.0-beta.32",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "25.6.0",
    "eslint": "10.2.0",
    "eslint-plugin-qwik": "2.0.0-beta.30",
    "globals": "17.5.0",
    "lucide-icons-qwik": "1.7.0-qwik-v2",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-icons-qwik": "16.12.0-qwik-v2",
    "tailwindcss": "^4.2.2",
    "ts-morph": "^28.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.2",
    "typescript-plugin-css-modules": "latest",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
