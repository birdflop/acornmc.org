{
  "name": "acornmc-org",
  "description": "The official website for AcornMC, a Minecraft server.",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vp build",
    "build.preview": "vp build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vp build -c adapters/ssg/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vp dev --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "vp fmt .",
    "fmt.check": "vp fmt --check .",
    "lint": "vp lint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vp preview --open",
    "start": "vp dev --open --mode ssr",
    "qwik": "qwik",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@luminescent/icons-qwik": "^0.1.1",
    "@luminescent/ui": "^7.0.1",
    "@luminescent/ui-qwik": "7.0.0-3",
    "@qwik.dev/core": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@8785",
    "@qwik.dev/router": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/router@8785",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "*",
    "globals": "17.7.0",
    "lucide-icons-qwik": "1.16.0-qwik-v2",
    "oxlint-plugin-qwik": "^0.0.9",
    "simple-icons-qwik": "16.19.0-qwik-v2",
    "tailwindcss": "^4.3.1",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5",
    "typescript-plugin-css-modules": "latest",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plus": "0.2.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "sharp"
  ],
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
  }
}
